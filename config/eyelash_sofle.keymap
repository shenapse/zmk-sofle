#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    MT_modifier: ModTap {
        compatible = "zmk,behavior-hold-tap";
        label = "MT_MODIFIER";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <70>;
        flavor = "tap-preferred";
        hold-trigger-key-positions = <43 41 47 49 48 42 40 50 54 55 56 57 59 60 61 62>;
        retro-tap;
    };

    LT_Tap_Preferred: on_LT {
        compatible = "zmk,behavior-hold-tap";
        label = "LT_Tap_Preferred";
        bindings = <&mo>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <70>;
        retro-tap;
        flavor = "tap-preferred";
        hold-trigger-key-positions = <40 50 37 38 51 26 39 57 59 27 56 55 60 61>;
    };

    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp ESC         &kp N1                   &kp N2                     &kp N3     &kp N4                     &kp N5                        &kp UP_ARROW     &kp N6                   &kp N7                     &kp N8         &kp N9                          &kp N0                &kp DELETE
&kp GRAVE       &kp Q                    &kp W                      &kp E      &kp R                      &kp T                         &kp DOWN_ARROW   &kp Y                    &kp U                      &kp I          &kp O                           &kp P                 &kp BSLH
&kp LEFT_SHIFT  &MT_modifier LCTRL A     &kp S                      &kp D      &kp F                      &kp G                         &kp LEFT_ARROW   &kp H                    &kp J                      &kp K          &kp L                           &MT_modifier RCTRL P  &kp RIGHT_SHIFT
&trans          &MT_modifier LEFT_ALT Z  &MT_modifier LEFT_SHIFT X  &kp C      &MT_modifier LCTRL V       &kp B                         &kp RIGHT_ARROW  &kp N                    &MT_modifier RCTRL M       &kp RIGHT_GUI  &MT_modifier LEFT_SHIFT PERIOD  &kp RIGHT_ALT         &trans
&kp C_MUTE      &trans                   &kp LEFT_GUI               &kp ENTER  &LT_Tap_Preferred 1 COMMA  &LT_Tap_Preferred 3 PERIOD    &kp DELETE       &LT_Tap_Preferred 2 TAB  &LT_Tap_Preferred 1 SPACE  &kp BACKSPACE  &kp DELETE                      &trans
            >;

            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW>;
            display-name = "LAYER0";
            label = "base";
        };

        layer_1 {
            bindings = <
&kp F11     &kp F1                               &kp F2                                   &kp F3                                           &kp F4                   &kp F5              &mmv MOVE_UP     &kp F6       &kp F7                 &kp F8      &kp F9         &kp F10    &kp F12
&trans      &trans                               &trans                                   &kp EXCLAMATION                                  &kp QUESTION             &trans              &mmv MOVE_DOWN   &kp SLASH    &kp ASTERISK           &kp CARET   &kp BACKSLASH  &trans     &trans
&trans      &MT_modifier GREATER_THAN LESS_THAN  &MT_modifier RIGHT_BRACKET LEFT_BRACKET  &MT_modifier RIGHT_PARENTHESIS LEFT_PARENTHESIS  &kp SEMI                 &kp SINGLE_QUOTE    &mmv MOVE_LEFT   &kp PERCENT  &kp EQUAL              &kp PLUS    &kp MINUS      &kp UNDER  &trans
&trans      &trans                               &trans                                   &kp AMPERSAND                                    &MT_modifier LCTRL PIPE  &trans              &mmv MOVE_RIGHT  &kp HASH     &MT_modifier RCTRL AT  &kp DOLLAR  &kp INT_YEN    &trans     &trans
&kp C_MUTE  &trans                               &trans                                   &trans                                           &kp LEFT_SHIFT           &trans              &mkp LCLK        &trans       &kp RIGHT_SHIFT        &trans      &trans         &trans
            >;

            display-name = "layer1";
            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        layer_2 {
            bindings = <
&kp F11  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5          &mmv MOVE_UP     &kp F6        &kp F7        &kp F8        &kp F9        &kp F10       &kp F12
&trans   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &mmv MOVE_DOWN   &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &trans
&trans   &kp NUMBER_6  &kp N7        &kp N8        &kp N9        &kp N0          &mmv MOVE_LEFT   &trans        &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp N0        &trans
&trans   &trans        &trans        &bootloader   &trans        &trans          &mmv MOVE_RIGHT  &trans        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_0  &trans
&trans   &trans        &trans        &trans        &trans        &trans          &mkp LCLK        &trans        &trans        &trans        &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans    &trans     &trans     &trans      &trans  &trans    &trans          &trans          &trans           &trans   &trans
&trans  &trans  &trans    &trans     &trans     &trans      &trans  &trans    &kp PAGE_UP     &kp UP_ARROW    &kp PAGE_DOWN    &trans   &trans
&trans  &trans  &mkp MB4  &mkp LCLK  &mkp RCLK  &mkp MB5    &trans  &kp HOME  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END  &trans
&trans  &trans  &trans    &trans     &trans     &trans      &trans  &trans    &trans          &trans          &trans           &trans   &trans
&trans  &trans  &trans    &trans     &trans     &trans      &trans  &trans    &trans          &trans          &trans           &trans
            >;
        };
    };
};
